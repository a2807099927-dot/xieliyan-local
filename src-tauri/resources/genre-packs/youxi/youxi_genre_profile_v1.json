    "dimensions": {
      "beats": {
        "weight": 5,
        "description": "必选剧情节点是否到位",
        "objective_check": "required_beats命中率 >= 80%"
      },
      "persona": {
        "weight": 5,
        "description": "与角色快照是否冲突",
        "objective_check": "persona_conflict_rate <= 0.3/千字",
        "forbidden_behaviors": [
          "主角主动道歉或寻求和解",
          "主角表现出胆怯或退缩",
          "主角进行脱离情境的哲学思辨",
          "主角进行复杂的道德挣扎和自我剖析",
          "主角对敌人产生文学性的同情揣测",
          "主角在战斗中犹豫不决或优柔寡断",
          "主角使用冗长礼貌的开场白"
        ]
      },
      "emotion": {
        "weight": 5,
        "description": "是否体现目标情绪递进",
        "objective_check": "情绪曲线波峰在章节中间或末尾，每1-2章至少一次波峰"
      },
      "causality": {
        "weight": 5,
        "description": "事件推进是否有因果链",
        "objective_check": "每个冲突必须有明确触发条件，冲突-解决-奖励循环完整"
      },
      "style": {
        "weight": 5,
        "description": "是否偏离style_profile",
        "objective_ratio": 3,
        "ai_ratio": 2,
        "objective_checks": [
          "平均句长在sentence_len_range范围内",
          "紧张场景短句比率达标",
          "无banned_words出现",
          "对话段落平均行数在1-2行范围内",
          "叙述段落平均行数在2-4行范围内",
          "无超过150字的连续说明段落（非设定章节）"
        ]
      }
    }
  },

